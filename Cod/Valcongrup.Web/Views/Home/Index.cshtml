@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">V</div>
            <div>
                <h1>ValconGrup</h1>
                <p>Management proiecte</p>
            </div>
        </div>

        <p class="menu-title">Meniu principal</p>
        <nav class="menu">
            <a class="menu-item active" href="#"><span class="menu-icon">□</span>Dashboard</a>
            <a class="menu-item" href="#"><span class="menu-icon">◫</span>Proiecte</a>
            <a class="menu-item" href="#"><span class="menu-icon">✓</span>Sarcini</a>
            <a class="menu-item" href="#"><span class="menu-icon">◉</span>Utilizatori</a>
            <a class="menu-item" href="#"><span class="menu-icon">◌</span>Rapoarte</a>
            <a class="menu-item" href="#"><span class="menu-icon">▣</span>Documente</a>
            <a class="menu-item" href="#"><span class="menu-icon">◷</span>Calendar</a>
        </nav>

        <p class="menu-title">Sistem</p>
        <nav class="menu">
            <a class="menu-item" href="#"><span class="menu-icon">⚙</span>Setari</a>
        </nav>

        <div class="profile-card">
            <div class="avatar">AI</div>
            <div>
                <h2>Alex Ionescu</h2>
                <p>Manager Proiect</p>
            </div>
        </div>
    </aside>

    <section class="content">
        <header class="topbar">
            <input class="search" type="text" placeholder="Cauta proiecte, sarcini sau documente..." />
            <div class="topbar-actions">
                <button class="notify-btn" type="button">◉</button>
                <button class="new-btn">Proiect Nou</button>
            </div>
        </header>

        <div class="heading">
            <h2>Privire de ansamblu</h2>
            <p>Monitorizeaza performanta proiectelor si activitatea echipei tale.</p>
        </div>

        <div class="stats-grid">
            <article class="stat-card">
                <div class="stat-head">
                    <span class="stat-icon">▦</span>
                    <span class="positive">+2 ↗</span>
                </div>
                <p>Proiecte Active</p>
                <h3>12</h3>
            </article>
            <article class="stat-card">
                <div class="stat-head">
                    <span class="stat-icon">◷</span>
                    <span class="negative">-5 ↘</span>
                </div>
                <p>Sarcini in Lucru</p>
                <h3>84</h3>
            </article>
            <article class="stat-card">
                <div class="stat-head">
                    <span class="stat-icon">◉</span>
                    <span class="positive">+12 ↗</span>
                </div>
                <p>Membri Echipa</p>
                <h3>145</h3>
            </article>
            <article class="stat-card">
                <div class="stat-head">
                    <span class="stat-icon">◫</span>
                    <span class="positive">+4.3% ↗</span>
                </div>
                <p>Buget Utilizat</p>
                <h3>68%</h3>
            </article>
        </div>

        <div class="panels">
            <article class="panel">
                <div class="panel-header">
                    <h4>Progres Proiecte</h4>
                    <a href="#">Vezi toate</a>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Nume proiect</th>
                            <th>Status</th>
                            <th>Progres</th>
                            <th>Termen limita</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong>Complex Rezidential Nord</strong>
                                <small>Estate Grup</small>
                            </td>
                            <td><span class="badge in-progress">In progres</span></td>
                            <td>
                                <div class="progress-cell">
                                    <span>75%</span>
                                    <div class="progress-track"><i style="width: 75%"></i></div>
                                </div>
                            </td>
                            <td>15 Oct 2026</td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Cladire Birouri Pipera</strong>
                                <small>Tech Spaces</small>
                            </td>
                            <td><span class="badge delayed">Intarziat</span></td>
                            <td>
                                <div class="progress-cell">
                                    <span>40%</span>
                                    <div class="progress-track"><i class="danger" style="width: 40%"></i></div>
                                </div>
                            </td>
                            <td>02 Dec 2026</td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Renovare Spitalul Central</strong>
                                <small>Ministerul Sanatatii</small>
                            </td>
                            <td><span class="badge in-progress">In progres</span></td>
                            <td>
                                <div class="progress-cell">
                                    <span>62%</span>
                                    <div class="progress-track"><i style="width: 62%"></i></div>
                                </div>
                            </td>
                            <td>28 Apr 2026</td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Parcare Subterana Unirii</strong>
                                <small>Primaria Capitalei</small>
                            </td>
                            <td><span class="badge in-progress">In progres</span></td>
                            <td>
                                <div class="progress-cell">
                                    <span>15%</span>
                                    <div class="progress-track"><i class="warning" style="width: 15%"></i></div>
                                </div>
                            </td>
                            <td>10 Feb 2027</td>
                        </tr>
                    </tbody>
                </table>
            </article>

            <article class="panel recent">
                <h4>Activitate Recenta</h4>
                <ul class="activity-list">
                    <li><span class="activity-avatar">MD</span><div><strong>Maria Dan</strong> a adaugat 3 planse noi <a href="#">Complex Rezidential Nord</a><small>Acum 2 ore</small></div></li>
                    <li><span class="activity-avatar">CR</span><div><strong>Cristian Radu</strong> a actualizat stadiul pentru <a href="#">Renovare Spitalul Central</a><small>Acum 5 ore</small></div></li>
                    <li><span class="activity-avatar">AI</span><div><strong>Alex Ionescu</strong> a aprobat bugetul suplimentar <a href="#">Cladire Birouri Pipera</a><small>Ieri, 14:10</small></div></li>
                    <li><span class="activity-avatar">EP</span><div><strong>Elena Popa</strong> a semnalat o intarziere pentru faza 2<small>Ieri, 11:25</small></div></li>
                </ul>
            </article>
        </div>
    </section>
</div>
